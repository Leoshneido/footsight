{
  "manifest_version": 3,
  "name": "footsight",
  "version": "1.1",
  "description": "Start footsight projects and capture video frames into them (⌘⇧S).",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
    "default_title": "footsight",
    "default_popup": "popup.html"
  },
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture the current video frame for footsight"
    }
  }
}
